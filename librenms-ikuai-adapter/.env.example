# ============================================================
# LibreNMS 实验环境 - 环境变量配置（脱敏示例）
# 参考: https://github.com/librenms/docker (examples/compose)
# 使用方法：复制为 .env，并把下面的占位符替换为你自己环境的真实值
# ============================================================

TZ=Asia/Shanghai

# 数据库（请替换为你自己环境的真实凭据，不要沿用示例值）
MYSQL_DATABASE=librenms
MYSQL_USER=librenms
MYSQL_PASSWORD=CHANGE_ME

# LibreNMS 容器内运行用户 UID/GID（保持默认即可，与挂载目录权限对应）
PUID=1000
PGID=1000

# 对外暴露端口（根据你所在环境实际情况调整，避免与现有服务冲突）
LIBRENMS_WEB_PORT=8091
LIBRENMS_SNMPTRAP_PORT=1622

# SNMP Trap接收配置（请替换为你自己环境使用的community字符串）
LIBRENMS_SNMP_COMMUNITY=CHANGE_ME

# 厂商私有MIB目录（放到 librenms/mibs/<厂商目录>/ 下），多个用:分隔
# 本仓库只包含iKuai适配，如目标环境还需要其他厂商MIB，请在该变量后按":"追加对应目录
SNMP_EXTRA_MIB_DIRS=/data/mibs/ikuai
