    					type76004GX32TX(110),       --"MRS-7600-4GX32TX",       
    					type760016FX(111),          --"MRS-7600-16FX",          
	   				type7600ES2GB(112),        --"MRS-7600-ES-2GB",        
    					type7604M4GX24TX(113),      --"MRS-7604-M4GX24TX",      
    					type7600ES(114),            --"MRS-7600-ES",            
    					type7608MI(115),            --"MRS-7608-MI",            
    					type7608MII(116),           --"MRS-7608-MII",           
    					type760012GB(117),          --"MRS-7600-12GB",          
    					type7604M8GB(118),          --"MRS-7604-M8GB",                                                  
    					type6804M12GB(165),         --"MRS-6804-M12GB",         
    					type680012GT(166),          --"MRS-6800-12GT",          
    					type6800210Gx(167),        --"MRS-6800-2-10Gx",        
    					type6800110Gx(168),        --"MRS-6800-1-10Gx",        
    					type6800CPU8245(169),       --"MRS-6800-CPU8245",       
    					type6800BACKPLANE(170),     --"MRS-6800-BACKPLANE",     
    					type680024GB(171),          --"MRS-6800-24GB",          
    					type680024GT(172),          --"MRS-6800-24GT",          
    					type680036TX(173),          --"MRS-6800-36TX",          
    					type68004GX32TX(174),       --"MRS-6800-4GX32TX",       
    					type680016FX(175),          --"MRS-6800-16FX",          
    					type6800ES2GB(176),        --"MRS-6800-ES-2GB",        
    					type6804M4GX24TX(177),      --"MRS-6804-M4GX24TX",      
    					type6800ES(178),            --"MRS-6800-ES",            
    					type6808MI(179),            --"MRS-6808-MI",            
    					type6808MII(180),           --"MRS-6808-MII",           
    					type680012GB(181),          --"MRS-6800-12GB",          
    					type6804M8GB(182),          --"MRS-6804-M8GB", 
    					type6804LM4GX24TX(183),          --"MRS-6804L-M4GX24TX", 
    					type68002XFP8GX16GB(184),          --"MRS-6800-2XFP8GX16GB",   
    					type68008GX16GB(185),          --"MRS-6800-8GX16GB",      
    					type68004GX24TX(186),          --"MRS-6800-4GX24TX", 
    					type68001XFP8GX16GB(187),          --"MRS-6800-1XFP8GX16GB",  
    					type76002XFP8GX16GB(188),          --"MRS-7600-2XFP8GX16GB",   
    					type76008GX16GB(189),          --"MRS-7600-8GX16GB",      
    					type76004GX24TX(190),          --"MRS-7600-4GX24TX", 
    					type76001XFP8GX16GB(191),          --"MRS-7600-1XFP8GX16GB",  
    					type7604LM4GX24TX(192),          --"MRS-7604L-M4GX24TX",     
                        other(254),--modify 03/1/21
                        notInstalled(255)--modify 03/1/21
                    }
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION "Type of expansion module in this switch slot."
        ::= { switchInfoEntry 3 }   
        
--********************************************************************************************************
--********************************************************************************************************  

--1.3.6.1.4.1.27282.100.5  vlanConfig

--***************************************
--vlaninfotable
--***************************************

--1.3.6.1.4.1.27282.100.5.1
vlanInfoTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF VlanInfoEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "A table containing current configuration information
        for each VLAN currently configured into the device by
        (local or network) management."
        ::= { priVlanConfig 1 }

--1.3.6.1.4.1.27282.100.5.1.1
vlanInfoEntry OBJECT-TYPE
        SYNTAX      VlanInfoEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "Static information for a VLAN configured into the
        device by (local or network) management."
        INDEX   { vlanID }
        ::= { vlanInfoTable 1 }

VlanInfoEntry ::= SEQUENCE
{
    vlanID             INTEGER,
    vlanName           DisplayString,
    vlanPortNumber     INTEGER,
    vlanRowStatus      RowStatus
}

        
--1.3.6.1.4.1.27282.100.5.1.1.1
vlanID OBJECT-TYPE
        SYNTAX      INTEGER (1..4094)
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "This value is vlan's ID."
        ::= { vlanInfoEntry 1 }

--1.3.6.1.4.1.27282.100.5.1.1.2
vlanName OBJECT-TYPE
        SYNTAX      DisplayString (SIZE (0..32))
        MAX-ACCESS  read-create
        STATUS      current
        DESCRIPTION "which may be used to identify the VLAN."
        ::= { vlanInfoEntry 2 }

--1.3.6.1.4.1.27282.100.5.1.1.3
vlanPortNumber OBJECT-TYPE
        SYNTAX      INTEGER (0..255)
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION "The sum of vlan's ports."
        ::= { vlanInfoEntry 3 }

--1.3.6.1.4.1.27282.100.5.1.1.4
vlanRowStatus OBJECT-TYPE
    SYNTAX      RowStatus
    MAX-ACCESS  read-create
    STATUS      current
    DESCRIPTION
        "This object indicates the status of this entry."
    ::= { vlanInfoEntry 4 }        
        
--***************************************
--vlanPortTable
--***************************************
--1.3.6.1.4.1.27282.100.5.2
vlanPortTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF VlanPortEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "A table containing per port control and status
        information for VLAN configuration in the device."
        ::= { priVlanConfig 2 }
        
--1.3.6.1.4.1.27282.100.5.2.1
vlanPortEntry OBJECT-TYPE
        SYNTAX      VlanPortEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "Information controlling VLAN configuration for a port
                    on the device."
        INDEX       { vlanportIndex }
        ::= { vlanPortTable 1 }

VlanPortEntry ::= SEQUENCE
{
    vlanportIndex        INTEGER,
    vlanportStatus       INTEGER,
    vlanportPvid          INTEGER
}

--1.3.6.1.4.1.27282.100.5.2.1.1
vlanportIndex OBJECT-TYPE
        SYNTAX      INTEGER
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION "A unique value for each interface. Its value
                      has the same relationship with the portTable's portIndex of mib."
        ::= { vlanPortEntry 1 }
        
--1.3.6.1.4.1.27282.100.5.2.1.2
vlanportStatus OBJECT-TYPE
        SYNTAX      INTEGER{
        		    access(1),
                            trunk(2)               
        	    }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION "This object indicates the status of this entry.
        		access(1) - this entry indicates the status of this port which is access.
        		trunk(2) - this entry indicates the sataus of tihs port which is trunk."
        ::= { vlanPortEntry 2 }        

--1.3.6.1.4.1.27282.100.5.2.1.3
vlanportPvid OBJECT-TYPE
        SYNTAX      INTEGER(1..4094)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION "The PVID, the VLAN ID assigned to untagged frames or
        Priority-Tagged frames received on this port.If this port is access,the Pvid is its Vid."
        ::= { vlanPortEntry 3 }
      
--***************************************
--vlanTrunkTable
--***************************************
--1.3.6.1.4.1.27282.100.5.3
vlanTrunkTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF VlanTrunkEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "A table containing per Trunk and Port control and status
        information for VLAN configuration in the device."
        ::= { priVlanConfig 3 }
        
--1.3.6.1.4.1.27282.100.5.3.1
vlanTrunkEntry OBJECT-TYPE
        SYNTAX      VlanTrunkEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "Information of trunk."
        INDEX   { trunkPortIndex }
        ::= { vlanTrunkTable 1 }
  
VlanTrunkEntry ::= SEQUENCE
{
    trunkPortIndex        INTEGER,
    allowAllVlan          INTEGER,
    allowVlanMap          VlanList
}
        
--1.3.6.1.4.1.27282.100.5.3.1.1
trunkPortIndex OBJECT-TYPE
        SYNTAX      INTEGER 
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION "A unique value for each trunk."
        ::= { vlanTrunkEntry 1 }
        
--1.3.6.1.4.1.27282.100.5.3.1.2
allowAllVlan OBJECT-TYPE
        SYNTAX      INTEGER{
        		    true(1),
        		    false(2)
        			}
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION "If the trunk allows all of vlan passing,
        	     the value is true(1),else false(2)"
        ::= { vlanTrunkEntry 2 }

--1.3.6.1.4.1.27282.100.5.3.1.3
allowVlanMap  OBJECT-TYPE
    SYNTAX      VlanList
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "This object indicates the status of this entry.
        it indicates that trunk allows which vlan to pass."
    ::= { vlanTrunkEntry 3 }
    
--********************************************************************************************************
--********************************************************************************************************
          
--1.3.6.1.4.1.27282.100.6 jumblyStacking

--1.3.6.1.4.1.27282.100.6.1
sysStackUnitNumber OBJECT-TYPE
    SYNTAX  INTEGER
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        " the number of the stacked units."
    ::= { priJumblyStacking  1 } 
               
--1.3.6.1.4.1.27282.100.6.2
jumblyStackingInfoTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF JumblyStackingInfoEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "Table of descriptive and status information about
                     jumbly stacking in this system."
        ::= { priJumblyStacking 2 }
          
--1.3.6.1.4.1.27282.100.6.1.1
jumblyStackingInfoEntry OBJECT-TYPE
        SYNTAX      JumblyStackingInfoEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "An entry in the table, containing information
                     about stacking switch in this system."
        INDEX       { swUnitIndex }
        ::= { jumblyStackingInfoTable 1 }

JumblyStackingInfoEntry ::= SEQUENCE
{
    stackingUnitIndex        INTEGER,
    swHardwareVersion       DisplayString,
    swSoftwareVersion       DisplayString,
    swCPUMac                MacAddress,
    swType                  DisplayString
}

--1.3.6.1.4.1.27282.100.6.1.1.1
stackingUnitIndex OBJECT-TYPE
        SYNTAX      INTEGER
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION "This object identifies the switch within the system
                     for which this entry contains information. This
                     value can never be greater than switchNumber."
        ::= { jumblyStackingInfoEntry 1 }

--1.3.6.1.4.1.27282.100.6.1.1.2
swHardwareVersion OBJECT-TYPE
    SYNTAX  DisplayString (SIZE(1..32))
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        " The text string denoting the version of the hardware."
    ::= { jumblyStackingInfoEntry  2 }

--1.3.6.1.4.1.27282.100.6.1.1.3
swSoftwareVersion OBJECT-TYPE
    SYNTAX  DisplayString (SIZE(1..32))
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        " The text string denoting the version of the software."
    ::= { jumblyStackingInfoEntry  3 }

--1.3.6.1.4.1.27282.100.6.1.1.4
swCPUMac OBJECT-TYPE
    SYNTAX  MacAddress
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        " the Mac address of the machine."
    ::= { jumblyStackingInfoEntry  4 } 
    
--1.3.6.1.4.1.27282.100.6.1.1.5
swType OBJECT-TYPE
    SYNTAX  DisplayString (SIZE(1..32))
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION "Type of this switch."
    ::= { jumblyStackingInfoEntry 5 }

--********************************************************************************************************
--******************************************************************************************************** 
    
--1.3.6.1.4.1.27282.100.7 uamSecurityPortMib

--1.3.6.1.4.1.27282.100.7.1
portSecurityTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF PortSecurityEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "The table of port security "
        ::= { priUamSecurityPortMib 1 }

--1.3.6.1.4.1.27282.100.7.1.1
portSecurityEntry OBJECT-TYPE
        SYNTAX      PortSecurityEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "An entry in the port security table."
        INDEX       { psPortIndex }
        ::= { portSecurityTable 1 }

PortSecurityEntry ::= SEQUENCE
{
    psPortIndex                 INTEGER,
    psPortSecurity              INTEGER,
    psSecuritytSaticMacAdd      MacAddress,
    psSecurityStaticMacDel      MacAddress,
    psSecurityPortLock          INTEGER,
    psSecurityPortMax           INTEGER,
    psSecurityPortConvertmac    INTEGER,
    psSecurityPortLocktimer     INTEGER
}

--1.3.6.1.4.1.27282.100.7.1.1.1
psPortIndex OBJECT-TYPE
        SYNTAX      INTEGER
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "A unique value for each port"
        ::= { portSecurityEntry 1 }
        
--1.3.6.1.4.1.27282.100.7.1.1.2
psPortSecurity OBJECT-TYPE
        SYNTAX      INTEGER {
                            disable(0),
                            enable(1)
                           }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION "enable or disable mac bind on this port"
        ::= { portSecurityEntry 2 } 
        
--1.3.6.1.4.1.27282.100.7.1.1.3
psSecuritytSaticMacAdd OBJECT-TYPE
        SYNTAX      MacAddress
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION "bind Security mac address on this port"
        ::= { portSecurityEntry 3 } 
        
--1.3.6.1.4.1.27282.100.7.1.1.4
psSecurityStaticMacDel OBJECT-TYPE
        SYNTAX      MacAddress
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION "delete Security mac address on this port"
        ::= { portSecurityEntry 4 }  
                  
--1.3.6.1.4.1.27282.100.7.1.1.5
psSecurityPortLock OBJECT-TYPE
        SYNTAX      INTEGER{
                            unlock(0),
                            lock(1)
                           }
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION "lock or unloc this port"
        ::= { portSecurityEntry 5 }
        
--1.3.6.1.4.1.27282.100.7.1.1.6
psSecurityPortMax OBJECT-TYPE
        SYNTAX      INTEGER (1..128)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION "Maximum secure addrs on this port"
        ::= { portSecurityEntry 6 }
 
--1.3.6.1.4.1.27282.100.7.1.1.7
psSecurityPortConvertmac OBJECT-TYPE
        SYNTAX      INTEGER (1..1)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION "convert dynamic mac to security mac"
        ::= { portSecurityEntry 7 }                                      

--1.3.6.1.4.1.27282.100.7.1.1.8
psSecurityPortLocktimer OBJECT-TYPE
        SYNTAX      INTEGER (0..300)
        MAX-ACCESS  read-write
        STATUS      current
        DESCRIPTION "lock timer on this port"
        ::= { portSecurityEntry 8 }
        
--1.3.6.1.4.1.27282.100.7.2
securityMacPortTable OBJECT-TYPE
        SYNTAX      SEQUENCE OF SecurityMacPortEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "Table of descriptive and status information about security port"
        ::= { priUamSecurityPortMib 2 }
        
--1.3.6.1.4.1.27282.100.7.2.1
securityMacPortEntry OBJECT-TYPE
        SYNTAX      SecurityMacPortEntry
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "An entry in the security mac port table."
        INDEX       { secPortIndex , secMacAdress }
        ::= { securityMacPortTable 1 }

SecurityMacPortEntry ::= SEQUENCE
{
    secPortIndex                 INTEGER,
    secMacAdress                 MacAddress,
    secVid                       INTEGER
}

--1.3.6.1.4.1.27282.100.7.2.1.1
secPortIndex OBJECT-TYPE
        SYNTAX      INTEGER
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION "A unique value for each port"
        ::= { securityMacPortEntry 1 }   

--1.3.6.1.4.1.27282.100.7.2.1.2
secMacAdress OBJECT-TYPE
        SYNTAX      MacAddress
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION "Mac adress bind on this port"
        ::= { securityMacPortEntry 2 }  
        
--1.3.6.1.4.1.27282.100.7.2.1.3
secVid OBJECT-TYPE
        SYNTAX      INTEGER
        MAX-ACCESS  read-only
        STATUS      current
        DESCRIPTION "vlan id of this port(pvid)"
        ::= { securityMacPortEntry 3 } 
        
--********************************************************************************************************
--******************************************************************************************************** 
         
-- (1.3.6.1.4.1.27282.100.8)   priIgmpSnoopingMib
    
--1.3.6.1.4.1.27282.100.8.1
priIgmpSnoopingGlobalEnable OBJECT-TYPE
    SYNTAX  INTEGER
    {
         disable(0),
         enable(1)
    }   
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION
        " Enable or disable the IgmpSnooping algorithm in the switch."
    ::= { priIgmpSnoopingMib  1 }

--1.3.6.1.4.1.27282.100.8.2
priIgmpSnoopingVlanTable OBJECT-TYPE
    SYNTAX  SEQUENCE OF PriIgmpSnoopingEntry
    MAX-ACCESS  not-accessible
    STATUS  current
    DESCRIPTION
        " IgmpSnooping confition in vlan."
    ::= { priIgmpSnoopingMib   2 }

--1.3.6.1.4.1.27282.100.8.2.1
    priIgmpSnoopingEntry OBJECT-TYPE
        SYNTAX  PriIgmpSnoopingEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            " IgmpSnooping confition in vlan."
        INDEX   { priIgmpSnoopingvlanID }
        ::= { priIgmpSnoopingVlanTable 1 }

    PriIgmpSnoopingEntry
        ::= SEQUENCE
            {
    		priIgmpSnoopingvlanID                  INTEGER,            
                priIgmpSnoopingvlanEnable              INTEGER,
                priIgmpSnoopingleave                   INTEGER,
                priIgmpSnoopingL2gen                   INTEGER,
                priIgmpSnoopingGroupNum                INTEGER,
                priIgmpSnoopingSourceNum               INTEGER,  
                priIgmpSnoopingPort		       PortList,
                priIgmpSnoopingPortTime		       INTEGER,
                priIgmpSnoopingQueryInterval	       INTEGER,
                priIgmpSnoopingQueryMrsp	       INTEGER,
                priIgmpSnoopingQueryRobustness         INTEGER,
                priIgmpSnoopingSuppression             INTEGER                                              
            }
            
--1.3.6.1.4.1.27282.100.8.2.1.1
priIgmpSnoopingvlanID OBJECT-TYPE
        SYNTAX      INTEGER
        MAX-ACCESS  not-accessible
        STATUS      current
        DESCRIPTION "This value is vlan's ID."
        ::= { priIgmpSnoopingEntry 1 }
                    
--1.3.6.1.4.1.27282.100.8.2.1.2
        priIgmpSnoopingvlanEnable OBJECT-TYPE
            SYNTAX      INTEGER
    	    {
         	disable(0),
         	enable(1)
    	    }             
            MAX-ACCESS  read-write
            STATUS      current
            DESCRIPTION " Enable or disable the IgmpSnooping in the switch.Default:0"
            ::= { priIgmpSnoopingEntry 2 } 
            
--1.3.6.1.4.1.27282.100.8.2.1.3
        priIgmpSnoopingleave OBJECT-TYPE
            SYNTAX      INTEGER
    	    {
         	no-immediate-leave(0),
         	immediate-leave(1)
    	    }             
            MAX-ACCESS  read-write
            STATUS      current
            DESCRIPTION " Enable or disable the immediate leave config.Default:0"
            ::= { priIgmpSnoopingEntry 3 } 
            
--1.3.6.1.4.1.27282.100.8.2.1.4
        priIgmpSnoopingL2gen OBJECT-TYPE
            SYNTAX      INTEGER
    	    {
         	no-l2-general-querier(0),
         	l2-general-querier(1)
    	    }             
            MAX-ACCESS  read-write
            STATUS      current
            DESCRIPTION " Enable or disable the l2-general-querier config.Default:0"
            ::= { priIgmpSnoopingEntry 4 } 
            
--1.3.6.1.4.1.27282.100.8.2.1.5
        priIgmpSnoopingGroupNum OBJECT-TYPE
            SYNTAX      INTEGER (1..65535)            
            MAX-ACCESS  read-write
            STATUS      current
            DESCRIPTION " Group number the IgmpSnooping in the switch."
            ::= { priIgmpSnoopingEntry 5 } 
            
--1.3.6.1.4.1.27282.100.8.2.1.6
        priIgmpSnoopingSourceNum OBJECT-TYPE
            SYNTAX      INTEGER (1..65535)         
            MAX-ACCESS  read-write
            STATUS      current
            DESCRIPTION " Source table number the IgmpSnooping in the switch."
            ::= { priIgmpSnoopingEntry 6 } 

--1.3.6.1.4.1.27282.100.8.2.1.7
        priIgmpSnoopingPort OBJECT-TYPE
            SYNTAX      PortList         
            MAX-ACCESS  read-write
            STATUS      current
            DESCRIPTION " Configure static mrouter port of vlan.
      		ehternet:  Name of Ethernet port
      		ifname:  Name of interface
      		port-channel: Port aggregation."
            ::= { priIgmpSnoopingEntry 7 } 

--1.3.6.1.4.1.27282.100.8.2.1.8
        priIgmpSnoopingPortTime OBJECT-TYPE
            SYNTAX      INTEGER (1..65535)       
            MAX-ACCESS  read-write
            STATUS      current
            DESCRIPTION " Configure this survive time of mrouter port.Default: 255s"
            ::= { priIgmpSnoopingEntry 8 } 

--1.3.6.1.4.1.27282.100.8.2.1.9
        priIgmpSnoopingQueryInterval OBJECT-TYPE
            SYNTAX      INTEGER(1..65535)      
            MAX-ACCESS  read-write
            STATUS      current
            DESCRIPTION " Configure this query interval. Default: 125s"
            ::= { priIgmpSnoopingEntry 9 } 
            
--1.3.6.1.4.1.27282.100.8.2.1.10
        priIgmpSnoopingQueryMrsp OBJECT-TYPE
            SYNTAX      INTEGER(1..25)     
            MAX-ACCESS  read-write
            STATUS      current
            DESCRIPTION " Configure the maximum query response period. Default: 10s"
            ::= { priIgmpSnoopingEntry 10 } 
            
--1.3.6.1.4.1.27282.100.8.2.1.11
        priIgmpSnoopingQueryRobustness OBJECT-TYPE
            SYNTAX      INTEGER        
            MAX-ACCESS  read-write
            STATUS      current
            DESCRIPTION " Configure the query robustness.Default: 2"
            ::= { priIgmpSnoopingEntry 11 }             

--1.3.6.1.4.1.27282.100.8.2.1.12
        priIgmpSnoopingSuppression OBJECT-TYPE
            SYNTAX      INTEGER        
            MAX-ACCESS  read-write
            STATUS      current
            DESCRIPTION " Configure the suppression query time.Default: 255s"
            ::= { priIgmpSnoopingEntry 12 } 
                                                                                                   
--********************************************************************************************************
--******************************************************************************************************** 
        
-- (1.3.6.1.4.1.27282.100.9)   QinQ group

--1.3.6.1.4.1.27282.100.9.1
dot1qTunnelTable OBJECT-TYPE
    SYNTAX  SEQUENCE OF Dot1qTunnelEntry
    MAX-ACCESS  not-accessible
    STATUS  current
    DESCRIPTION
    	" the state of power"
    ::= { priQinQmib  1}   

--1.3.6.1.4.1.27282.100.9.1
dot1qTunnelEntry OBJECT-TYPE
        SYNTAX  Dot1qTunnelEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            " configure of dot1qTunnel"
        INDEX   { qinqPortIndex }
        ::= { dot1qTunnelTable 1 }
        
Dot1qTunnelEntry
        ::= SEQUENCE
            {
            	qinqPortIndex			INTEGER,
            	tunnelPortEnable		INTEGER,
                tunnelPortType			INTEGER
            }

--1.3.6.1.4.1.27282.100.9.1.1
qinqPortIndex OBJECT-TYPE
    SYNTAX  INTEGER
            MAX-ACCESS  not-accessible
            STATUS  current
            DESCRIPTION
                "Index of Port."
            ::= { dot1qTunnelEntry 1 } 
            
--1.3.6.1.4.1.27282.100.9.1.2
tunnelPortEnable OBJECT-TYPE
    SYNTAX  INTEGER {
                disable(0),
                enable(1)
            }
            MAX-ACCESS  read-write
            STATUS  current
            DESCRIPTION
                "Enable or disable the dot1q-tunnel in this port."
            ::= { dot1qTunnelEntry 2 }  
            
--1.3.6.1.4.1.27282.100.9.1.3
tunnelPortType OBJECT-TYPE
    SYNTAX  INTEGER 
            MAX-ACCESS  read-write
            STATUS  current
            DESCRIPTION
                "Protocol type of trunk port(TPID)(exp:8100/9100/9200)."
            ::= { dot1qTunnelEntry 3 }   


            
--1.3.6.1.4.1.27282.100.9.2
vlanTranslationTable OBJECT-TYPE
    SYNTAX  SEQUENCE OF VlanTranslationEntry
    MAX-ACCESS  not-accessible
    STATUS  current
    DESCRIPTION
    	" VLAN translation basic config."
    ::= { priQinQmib  2}   

--1.3.6.1.4.1.27282.100.9.2.1
vlanTranslationEntry OBJECT-TYPE
        SYNTAX  VlanTranslationEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            "VLAN translation"
        INDEX   { translatPortIndex }
        ::= { vlanTranslationTable 1 }
        
VlanTranslationEntry
        ::= SEQUENCE
            {
            	translatPortIndex	      INTEGER,
    		translationEnable             INTEGER,
    		translationDropType           INTEGER		
            }
 
--1.3.6.1.4.1.27282.100.9.2.1.1
translatPortIndex OBJECT-TYPE
    SYNTAX  INTEGER 
            MAX-ACCESS  not-accessible
            STATUS  current
            DESCRIPTION
                "Index of Port."
            ::= { vlanTranslationEntry 1 }
            
--1.3.6.1.4.1.27282.100.9.2.1.2
translationEnable OBJECT-TYPE
    SYNTAX  INTEGER {
                disable(0),
                enable(1)
            }
            MAX-ACCESS  read-write
            STATUS  current
            DESCRIPTION
                "Index of Slot."
            ::= { vlanTranslationEntry 2 }  
            
--1.3.6.1.4.1.27282.100.9.2.1.3
translationDropType OBJECT-TYPE
    SYNTAX  INTEGER {
		in(1),
		out(2),
		both(3),
		noIn(4),
		noOut(5),
		noBoth(6)
            }
            MAX-ACCESS  read-write
            STATUS  current
            DESCRIPTION
                "Index of Slot."
            ::= { vlanTranslationEntry 3 } 


--1.3.6.1.4.1.27282.100.9.3
vlanTranslationTypeTable OBJECT-TYPE
    SYNTAX  SEQUENCE OF VlanTranslationTypeEntry
    MAX-ACCESS  not-accessible
    STATUS  current
    DESCRIPTION
    	" the state of power"
    ::= { priQinQmib  3}   

--1.3.6.1.4.1.27282.100.9.3.1
vlanTranslationTypeEntry OBJECT-TYPE
        SYNTAX  VlanTranslationTypeEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            " the state of power"
        INDEX   { translatPortTypeIndex , translationType }
        ::= { vlanTranslationTypeTable 1 }
        
VlanTranslationTypeEntry
        ::= SEQUENCE
            {
            	translatPortTypeIndex	      INTEGER,
    		translationType               INTEGER, 
    		translationOldVlanid   	      INTEGER,
    		translationNewVlanid   	      INTEGER,
    		translationTypeStatus	      INTEGER			
            }
 
--1.3.6.1.4.1.27282.100.9.3.1.1
translatPortTypeIndex OBJECT-TYPE
    SYNTAX  INTEGER 
            MAX-ACCESS  not-accessible
            STATUS  current
            DESCRIPTION
                "Index of Slot."
            ::= { vlanTranslationTypeEntry 1 }

        
--1.3.6.1.4.1.27282.100.9.3.1.2
translationType OBJECT-TYPE
    SYNTAX  INTEGER{
		in(1),
		out(2)    
    		}
            MAX-ACCESS  not-accessible
            STATUS  current
            DESCRIPTION
                "Index of Slot."
            ::= { vlanTranslationTypeEntry 2 } 

--1.3.6.1.4.1.27282.100.9.3.1.3
translationOldVlanid OBJECT-TYPE
    SYNTAX  INTEGER
            MAX-ACCESS  read-create
            STATUS  current
            DESCRIPTION
                "Index of Slot."
            ::= { vlanTranslationTypeEntry 3 } 
            
--1.3.6.1.4.1.27282.100.9.3.1.4
translationNewVlanid OBJECT-TYPE
    SYNTAX  INTEGER
            MAX-ACCESS  read-create
            STATUS  current
            DESCRIPTION
                "Index of Slot."
            ::= { vlanTranslationTypeEntry 4 } 

--1.3.6.1.4.1.27282.100.9.3.1.5
        translationTypeStatus OBJECT-TYPE
            SYNTAX  INTEGER
            	    {
            	    	createAndGo(0),
               		active(1),
               		destroy(2)
            	    }
            MAX-ACCESS  read-create
            STATUS  current
            DESCRIPTION
                " now state of the access-list."
            ::= { vlanTranslationTypeEntry  5 }    

                                       
