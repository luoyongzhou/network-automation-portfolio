        "Enable non-standard PD compatibility function."
    ::= { priPoeConfig  4}              
    
--1.3.6.1.4.1.27282.100.26.5
poeDisconnect OBJECT-TYPE
    SYNTAX  INTEGER {
                ac (1),
                dc (0),
            }
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        "Remote power supply capability for opening ports."
    ::= { priPoeConfig  5}
    
--1.3.6.1.4.1.27282.100.26.6
poeCurrentPower OBJECT-TYPE
    SYNTAX  INTEGER 
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        "current output power."
    ::= { priPoeConfig  6}      
        
--1.3.6.1.4.1.27282.100.26.8
poeSoftwareVersion OBJECT-TYPE
    SYNTAX  DisplayString (SIZE(1..32))
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        "Software version of poe"
    ::= { priPoeConfig  8}
    
--1.3.6.1.4.1.27282.100.26.9
poeHardwareVersion OBJECT-TYPE
    SYNTAX  DisplayString (SIZE(1..32))
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        "Hardware version of poe"
    ::= { priPoeConfig  9}     
    
--1.3.6.1.4.1.27282.100.26.10
poePortConfigTable OBJECT-TYPE 
    SYNTAX  SEQUENCE OF poePortConfigEntry
    MAX-ACCESS  not-accessible
    STATUS  current
    DESCRIPTION
        " the information of poePortConfig."
    ::= { priPoeConfig   10}

--1.3.6.1.4.1.27282.100.26.10.1
poePortConfigEntry OBJECT-TYPE
        SYNTAX  poePortConfigEntry
        MAX-ACCESS  not-accessible
        STATUS  current
        DESCRIPTION
            " the information of poePortConfig."
        INDEX   { sysSlotIndex }
        ::= { poePortConfigTable 1 }
        
poePortConfigEntry
        ::= SEQUENCE
            {
            	poePortIndex			INTEGER,
                poePortStatus			INTEGER,            	
                poePortPriority			INTEGER,
                poePortMaxPower			INTEGER,
                poePortCurrentPower		INTEGER,
                poePortCurrentCurrent	INTEGER,
                poePortCurrentVoltage	INTEGER,
                poePortPdStatus			INTEGER,
                poePortPdClass			INTEGER	
            }
            
--1.3.6.1.4.1.27282.100.26.10.1.1
poePortIndex OBJECT-TYPE
            SYNTAX  INTEGER 
            MAX-ACCESS  not-accessible
            STATUS  current
            DESCRIPTION
                "Index of poePortConfig."
            ::= { poePortConfigEntry 1 }
            
--1.3.6.1.4.1.27282.100.26.10.1.2
poePortStatus OBJECT-TYPE
    		SYNTAX  INTEGER {
                auto(1),
                static(2),
                disable(0)
            }
            MAX-ACCESS  read-write
            STATUS  current
            DESCRIPTION
                "control poe port status."
            ::= { poePortConfigEntry 2 }
            
--1.3.6.1.4.1.27282.100.26.10.1.3
poePortPriority OBJECT-TYPE
    		SYNTAX  INTEGER {  
				critical (1),                  
                high (2),
                low (3),
            }                    
            MAX-ACCESS  read-write
            STATUS  current
            DESCRIPTION
                "Set Port Power Priority."
            ::= { poePortConfigEntry 3 }
 
--1.3.6.1.4.1.27282.100.26.10.1.4
poePortMaxPower OBJECT-TYPE
    		SYNTAX  INTEGER (1..90000)
    		MAX-ACCESS  read-write
            STATUS  current
            DESCRIPTION
                "Set the port max output power, unit:mW"
            ::= { poePortConfigEntry 4 }
            
--1.3.6.1.4.1.27282.100.26.10.1.5
poePortCurrentPower OBJECT-TYPE
    		SYNTAX  INTEGER
    		MAX-ACCESS  read-only
            STATUS  current
            DESCRIPTION
                "get the port real time power,unit:mW"
            ::= { poePortConfigEntry 5 } 
            
--1.3.6.1.4.1.27282.100.26.10.1.6
poePortCurrentCurrent OBJECT-TYPE
    		SYNTAX  INTEGER
    		MAX-ACCESS  read-only
            STATUS  current
            DESCRIPTION
                "get the port real time current,unit:mA"
            ::= { poePortConfigEntry 6 }
            
--1.3.6.1.4.1.27282.100.26.10.1.7
poePortCurrentVoltage OBJECT-TYPE
    		SYNTAX  INTEGER
    		MAX-ACCESS  read-only
            STATUS  current
            DESCRIPTION
                "get the port real time voltage,unit:V"
            ::= { poePortConfigEntry 7 }
            
--1.3.6.1.4.1.27282.100.26.10.1.8
poePortPdStatus OBJECT-TYPE
    		SYNTAX  INTEGER {
    			on(1),
    			off(2),
    			faulty(3),
    			deny(4),
    			force(5)
    		}
    		MAX-ACCESS  read-only
            STATUS  current
            DESCRIPTION
                "Port power supply status"
            ::= { poePortConfigEntry 8 } 
            
--1.3.6.1.4.1.27282.100.26.10.1.9
poePortPdClass OBJECT-TYPE
    		SYNTAX  INTEGER {
			notApplicable(10)
    		}
    		MAX-ACCESS  read-only
            STATUS  current
            DESCRIPTION
                "Port power supply class"
            ::= { poePortConfigEntry 9 }  
            
--1.3.6.1.4.1.27282.100.26.11
poeHighInrushEnable OBJECT-TYPE
    SYNTAX  INTEGER {
                enable (1),
                disable (0),
            }
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION
        "Enable the high impact current function that allows for instant power on."
    ::= { priPoeConfig  11} 
