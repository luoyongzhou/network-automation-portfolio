-- (1.3.6.1.4.1.27282.100.1)   System group

--1.3.6.1.4.1.27282.100.1.1
sysResetUnit OBJECT-TYPE
    SYNTAX  INTEGER {
                noReset(1),
                factoryReset (2),
                warmReset (3)
            }
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION
        " factoryReset(2) sets all switch operating parameters to the factory
        default; warmReset(3) cause warm reboots
        of the switch.  A set with a value of noReset(1) causes no action
        on the part of the switch.  The switch will return  noReset(1)
        value upon a read of this object."
    ::= { priSystem  1}
    
--1.3.6.1.4.1.27282.100.1.2
sysHardwareVersion OBJECT-TYPE
    SYNTAX  DisplayString (SIZE(1..32))
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        " The text string denoting the version of the hardware."
    ::= { priSystem  2 }
    
--1.3.6.1.4.1.27282.100.1.3
sysSoftwareVersion OBJECT-TYPE
    SYNTAX  DisplayString (SIZE(1..32))
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        " The text string denoting the version of the software."
    ::= { priSystem  3 }
    
--1.3.6.1.4.1.27282.100.1.4
sysStackFlag OBJECT-TYPE
     SYNTAX  INTEGER {
             stack(1),
             noStack (2)
            }
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        " The vlaue of denoting whether the switch is stacking."
    ::= { priSystem  4 }
    
--1.3.6.1.4.1.27282.100.1.5
sysCPUMac OBJECT-TYPE
    SYNTAX  MacAddress
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        " the Mac address of the machine."
    ::= { priSystem  5 }

--1.3.6.1.4.1.27282.100.1.6
sysWriteConfig OBJECT-TYPE
    SYNTAX  INTEGER {
                write(1)
            }
    MAX-ACCESS  read-write
    STATUS  current
    DESCRIPTION
        "    write(1) saves the running configuration. 
        Its functionality is just like 'write' command in console mode. 
        The switch will return  write(1)
        value upon a read of this object. "
    ::= { priSystem  6 }  

--1.3.6.1.4.1.27282.100.1.7
sysPowerStateTable OBJECT-TYPE 
    SYNTAX  SEQUENCE OF SysPowerStateEntry
    MAX-ACCESS  not-accessible
    STATUS  current
    DESCRIPTION
        " the state of slot."
    ::= { priSystem   7}

