                qosPolicyRateKbps		INTEGER,
                qosPolicyRurstKbps		INTEGER,
                qosPolicyExceedAction 		INTEGER,
                qosPolicyAggregatePolicer	DisplayString,
                qosPolicyStatus			INTEGER                               
            }

--1.3.6.1.4.1.27282.100.10.2.4.1.1
        qosPolicyName OBJECT-TYPE
            SYNTAX  DisplayString
            MAX-ACCESS  not-accessible
            STATUS  current
            DESCRIPTION
                "QoS Policy name"
            ::= { qosPolicyEntry 1 }

--1.3.6.1.4.1.27282.100.10.2.4.1.2
        qosPolicySpLabel OBJECT-TYPE
            SYNTAX  DisplayString
            MAX-ACCESS  read-create
            STATUS  current
            DESCRIPTION
                "Specify the classification."
            ::= { qosPolicyEntry 2 }

--1.3.6.1.4.1.27282.100.10.2.4.1.3
        qosPolicyType OBJECT-TYPE
            SYNTAX  INTEGER            	
            	{
            	    	sp(0),
               		aggregatePolicer(1)         	
            	}
            MAX-ACCESS  read-create
            STATUS  current
            DESCRIPTION
                "Rate Bandwidth of After the classification."
            ::= { qosPolicyEntry 3 }
            
--1.3.6.1.4.1.27282.100.10.2.4.1.4
        qosPolicyRateKbps OBJECT-TYPE
            SYNTAX  INTEGER(1..10000000)
            MAX-ACCESS  read-create
            STATUS  current
            DESCRIPTION
                "Rate Bandwidth of After the classification.
                This object be configured only if qosPolicyType 
                in the same row is aggregatePolicer(0). "
            ::= { qosPolicyEntry 4 }            

--1.3.6.1.4.1.27282.100.10.2.4.1.5
        qosPolicyRurstKbps OBJECT-TYPE
            SYNTAX  INTEGER(1..1000000)
            MAX-ACCESS  read-create
            STATUS  current
            DESCRIPTION
                "Rurst Bandwidth of After the classification.
                This object be configured only if qosPolicyType 
                in the same row is aggregatePolicer(0). "
            ::= { qosPolicyEntry 5 }   

--1.3.6.1.4.1.27282.100.10.2.4.1.6
        qosPolicyExceedAction OBJECT-TYPE
            SYNTAX  INTEGER
            	{
            	    	drop(0),
               		policeDscpTransmit(1)         	
            	}
            MAX-ACCESS  read-create
            STATUS  current
            DESCRIPTION
                "The policy When beyond the reach of appointed velocity.
