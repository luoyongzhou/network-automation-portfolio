sysMemorySize OBJECT-TYPE
    SYNTAX  INTEGER
    MAX-ACCESS  read-only
    STATUS  current
    DESCRIPTION
        " the number of the memory units of this slot."
    ::= { sysSlotEntry  5 }  
    
 --1.3.6.1.4.1.27282.100.1.8.1.6
sysMemoryBusy OBJECT-TYPE
    SYNTAX  INTEGER
    MAX-ACCESS  read-only
