# ---- collect_configs.py ----
# 设备配置本地存储目录
CONFIG_BACKUP_DIR=/home/network_device_configs
# Nornir 配置文件路径
NORNIR_CONFIG_FILE=./config/config.yaml

# ---- git_configs.sh ----
# Git 备份仓库地址（含账号/token 的完整 URL，切勿提交到仓库）
GIT_BACKUP_REPO_URL=https://<user>:<token>@git.example.com/ops/netdevice.git
# 配置历史保留天数，超过则自动清理
GIT_BACKUP_RETENTION_DAYS=90
GIT_BACKUP_USER_NAME=netdevice-backup
GIT_BACKUP_USER_EMAIL=netdevice-backup@example.com

# ---- ping_monitor.py ----
# 监控目标清单，JSON 格式 {"IP": "备注"}
PING_TARGETS={"10.0.0.1": "示例网关", "10.0.0.2": "示例服务器"}
# 钉钉自定义机器人 Webhook
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=changeme
PING_MAX_WORKERS=10
PING_COUNT=2
PING_TIMEOUT=1.0
